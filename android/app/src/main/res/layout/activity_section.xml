<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/sectionRoot" android:background="#031510"
 android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:id="@+id/sectionContent" android:orientation="vertical" android:background="#031510"
  android:layout_width="match_parent" android:layout_height="match_parent">
  <LinearLayout android:orientation="horizontal" android:gravity="center_vertical"
   android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp"
   android:background="#071F18" android:layout_width="match_parent" android:layout_height="wrap_content">
   <Button android:id="@+id/backButton" android:text="‹" android:textSize="26sp" android:textAllCaps="false"
    android:textColor="#E9D7A5" android:background="@android:color/transparent"
    android:minWidth="48dp" android:layout_width="48dp" android:layout_height="48dp"/>
   <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
    <TextView android:id="@+id/sectionTitle" android:text="Drita Hanefi" android:textColor="#FFF8E7" android:textStyle="bold" android:textSize="18sp" android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/sectionSubtitle" android:text="Dituria • Burimi • Praktika" android:textColor="#B7C9BF" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content"/>
   </LinearLayout>
   <Button android:id="@+id/homeButton" android:text="⌂" android:textSize="22sp" android:textColor="#E9D7A5"
    android:background="@android:color/transparent" android:minWidth="48dp" android:layout_width="48dp" android:layout_height="48dp"/>
  </LinearLayout>
  <View android:background="#8A6A2F" android:layout_width="match_parent" android:layout_height="1dp"/>
  <WebView android:id="@+id/sectionWebView" android:background="#031510" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
 </LinearLayout>
 <FrameLayout android:id="@+id/fullscreenMedia" android:visibility="gone" android:background="#000000"
  android:layout_width="match_parent" android:layout_height="match_parent"/>
</FrameLayout>
