<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#031510"><LinearLayout android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/quranBack" android:text="‹ Ballina" android:textAllCaps="false" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Enciklopedia e Kuranit" android:textColor="#E8C96D" android:textStyle="bold" android:textSize="29sp" android:layout_marginTop="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/quranStatus" android:textColor="#B8CEC5" android:layout_marginBottom="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="HIFZI" android:textColor="#E8C96D" android:textStyle="bold" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Zgjidh suren, ajetin e fillimit, sa ajete dhe sa herë të përsëriten." android:textColor="#F8F5E9" android:layout_marginBottom="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Spinner android:id="@+id/surah" android:layout_width="match_parent" android:layout_height="52dp"/>
<Spinner android:id="@+id/startAyah" android:layout_width="match_parent" android:layout_height="52dp"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content"><Spinner android:id="@+id/groupCount" android:layout_weight="1" android:layout_width="0dp" android:layout_height="52dp"/><Spinner android:id="@+id/repeatCount" android:layout_weight="1" android:layout_width="0dp" android:layout_height="52dp"/></LinearLayout>
<Button android:id="@+id/startHifz" android:text="Fillo grupin e ajeteve" android:textAllCaps="false" android:layout_width="match_parent" android:layout_height="52dp"/>
<TextView android:id="@+id/hifzProgress" android:textColor="#E8C96D" android:textStyle="bold" android:layout_marginTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<LinearLayout android:id="@+id/verses" android:orientation="vertical" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>